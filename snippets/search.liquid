{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {string} [bar_style] - When 'bar', the button is restyled on desktop as a wide,
    input-like bar with a placeholder instead of a plain icon/text button. Still opens
    the same search modal on click; no new search behavior is introduced.
  @param {string} [placeholder] - Placeholder text shown when bar_style is 'bar'.

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
  {% render 'search', style: 'default', bar_style: 'bar', placeholder: 'Search products' %}
{%- enddoc -%}

{% liquid
  assign bar_placeholder = placeholder
  if bar_placeholder == blank
    assign bar_placeholder = 'content.search_input_label' | t
  endif
%}

{% unless style == 'none' %}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text{% endif %}{% if bar_style == 'bar' %} search-action--bar{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}{% if bar_style == 'bar' %} search-action__bar-button{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="svg-wrapper {% if display_style != 'icon' and bar_style != 'bar' %}desktop:hidden{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>

      {% if bar_style == 'bar' %}
        <span class="search-action__bar-placeholder mobile:hidden">{{ bar_placeholder }}</span>
      {% else %}
        <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
          {{ 'content.search' | t }}
        </span>
      {% endif %}
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }

  /* "Bar" style: looks like a wide input, still just opens the search modal */
  .search-action--bar {
    width: 100%;
    margin-inline: 0;
  }

  .search-action__bar-button {
    width: 100%;
    justify-content: flex-start;
    gap: var(--gap-xs);
    color: var(--color-foreground-muted, var(--color-foreground));

    @media screen and (min-width: 750px) {
      padding: var(--padding-sm) var(--padding-md);
      border: var(--search-border-width) solid var(--color-border);
      border-radius: var(--search-border-radius);
      background-color: var(--color-background);
    }
  }

  .search-action__bar-placeholder {
    font-size: var(--font-size--sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
{% endstylesheet %}
