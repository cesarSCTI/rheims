{% liquid
  assign application = product.metafields.custom.application.value | default: section.settings.application
%}
{% capture rows %}
  {% for block in section.blocks %}
    {% liquid
      assign value = ''
      if block.settings.metafield_key != blank
        assign product_value = product.metafields.custom[block.settings.metafield_key].value
        assign value = product_value | strip
      endif
    %}
    {% if value != blank %}
      <tr {{ block.shopify_attributes }}>
        <th scope="row">{{ block.settings.title | escape }}</th>
        <td>{{ value | escape | newline_to_br }}</td>
      </tr>
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign rows_content = rows | strip %}
{% if rows_content != blank or application != blank %}
  {{ 'rheims-product.css' | asset_url | stylesheet_tag }}
  <section class="section section--page-width rheims-specifications" aria-labelledby="Specifications-{{ section.id }}">
    <div class="rheims-specifications__inner">
      <h2 id="Specifications-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if application != blank %}<div class="rheims-specifications__application"><strong>Aplicación:</strong><br>{{ application | escape | newline_to_br }}</div>{% endif %}
      {% if rows_content != blank %}<table><caption class="visually-hidden">{{ section.settings.heading | escape }}</caption><tbody>{{ rows }}</tbody></table>{% endif %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "Especificaciones técnicas",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Especificaciones técnicas"
    },
    {
      "type": "textarea",
      "id": "application",
      "label": "Aplicación",
      "info": "Puedes usar custom.application (texto) para definirla por producto."
    }
  ],
  "blocks": [
    {
      "type": "specification",
      "name": "Especificación",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre",
          "default": "Característica"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Clave del metacampo custom",
          "info": "Clave exacta dentro de custom. Si el producto no tiene valor, la fila se oculta."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Especificaciones técnicas",
      "blocks": [
        {
          "type": "specification",
          "settings": {
            "title": "Tipo",
            "metafield_key": "tipo"
          }
        },
        {
          "type": "specification",
          "settings": {
            "title": "Diámetro exterior",
            "metafield_key": "diametro_exterior"
          }
        },
        {
          "type": "specification",
          "settings": {
            "title": "Rosca de acoplamiento",
            "metafield_key": "rosca_de_acoplamiento"
          }
        },
        {
          "type": "specification",
          "settings": {
            "title": "Altura",
            "metafield_key": "altura"
          }
        },
        {
          "type": "specification",
          "settings": {
            "title": "Acabado",
            "metafield_key": "acabado"
          }
        },
        {
          "type": "specification",
          "settings": {
            "title": "Cabezales compatibles",
            "metafield_key": "cabezales_compatibles"
          }
        }
      ]
    }
  ]
}
{% endschema %}
